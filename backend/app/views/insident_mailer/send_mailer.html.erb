<!doctype html>
<html lang="pt-BR">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">

    <title>Notificação de ocorrência - IFMS</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f6f8;
        font-family: Arial, Helvetica, sans-serif;
        color: #333333;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table {
        border-collapse: collapse;
        border-spacing: 0;
      }

      img {
        border: 0;
        outline: none;
        text-decoration: none;
        display: block;
        max-width: 100%;
        height: auto;
      }

      a {
        color: #006b3f;
        text-decoration: none;
      }

      .wrapper {
        width: 100%;
        background-color: #f4f6f8;
        padding: 40px 15px;
      }

      .container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
      }

      .card {
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      }

      .header {
        padding: 28px 35px;
        text-align: center;
        border-bottom: 1px solid #eeeeee;
      }

      .logo {
        width: 180px;
        margin: 0 auto;
      }

      .content {
        padding: 40px 45px;
      }

      .title {
        margin: 0 0 12px;
        font-size: 23px;
        line-height: 1.3;
        font-weight: 600;
        color: #1f2933;
      }

      .subtitle {
        margin: 0 0 28px;
        font-size: 15px;
        line-height: 1.6;
        color: #667085;
      }

      .message {
        margin: 0 0 18px;
        font-size: 15px;
        line-height: 1.7;
        color: #444444;
      }

      .notice {
        margin: 28px 0;
        padding: 18px 20px;
        background-color: #f0f8f4;
        border-left: 4px solid #006b3f;
        border-radius: 4px;
      }

      .notice p {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: #3f4a45;
      }

      .button-wrapper {
        padding: 10px 0 25px;
        text-align: center;
      }

      .button {
        display: inline-block;
        padding: 13px 26px;
        background-color: #006b3f;
        color: #ffffff !important;
        font-size: 15px;
        font-weight: bold;
        border-radius: 5px;
      }

      .footer {
        padding: 25px 20px;
        text-align: center;
        color: #8a8f98;
        font-size: 12px;
        line-height: 1.6;
      }

      .footer strong {
        color: #687078;
      }

      @media only screen and (max-width: 620px) {
        .wrapper {
          padding: 20px 10px !important;
        }

        .content {
          padding: 30px 22px !important;
        }

        .header {
          padding: 24px 20px !important;
        }

        .title {
          font-size: 21px !important;
        }

        .message,
        .subtitle {
          font-size: 15px !important;
        }

        .button {
          display: block !important;
          text-align: center !important;
        }
      }
    </style>
  </head>

  <body>
    <!-- Preheader -->
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">
      Nova ocorrência cadastrada no sistema do IFMS.
    </div>

    <table role="presentation" width="100%">
      <tr>
        <td class="wrapper">
          <table role="presentation" class="container" width="100%">
            <tr>
              <td>
                <!-- CARD -->
                <table role="presentation" width="100%" class="card">
                  <!-- HEADER -->
                  <tr>
                    <td class="header">
                      <img src="https://selecao.ifms.edu.br/assets/images/ifms-cor.png" alt="Instituto Federal de Mato Grosso do Sul" class="logo">
                    </td>
                  </tr>

                  <!-- CONTENT -->
                  <tr>
                    <td class="content">
                      <h1 class="title">
                        Nova ocorrência cadastrada
                      </h1>

                      <p class="subtitle">
                        Notificação destinada à coordenação do curso.
                      </p>

                      <p class="message">
                        Olá, senhor(a) coordenador(a).
                      </p>

                      <p class="message">
                        Foi registrada uma nova ocorrência relacionada ao curso que o(a) senhor(a) coordena.
                      </p>

                      <div class="notice">
                        <p>
                          Acesse o sistema para consultar os detalhes da ocorrência e realizar os procedimentos necessários.
                        </p>
                      </div>

                      <!-- BUTTON -->
                      <table role="presentation" width="100%">
                        <tr>
                          <td class="button-wrapper">
                            <a href="https://sigoe.na.ifms.edu.br" class="button" target="_blank">
                              Acessar o sistema
                            </a>
                          </td>
                        </tr>
                      </table>

                      <p class="message" style="font-size: 13px; color: #777777; margin-bottom: 0;">
                        Caso o botão não funcione, acesse:
                        <a href="https://sigoe.na.ifms.edu.br">
                          sigoe.na.ifms.edu.br
                        </a>
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- FOOTER -->
                <table role="presentation" width="100%">
                  <tr>
                    <td class="footer">
                      <strong>
                        IFMS — Instituto Federal de Mato Grosso do Sul
                      </strong>

                      <br>

                      Campus Nova Andradina

                      <br><br>

                      Esta é uma mensagem automática enviada pelo sistema.

                      <br>

                      Por favor, não responda a este e-mail.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>